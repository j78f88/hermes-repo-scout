{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-scout.local/schemas/report.v1.schema.json",
  "title": "repo-scout Report v1",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "generated_by", "status", "repo", "goal", "summary", "verdict", "claims", "evidence", "findings", "limitations"],
  "properties": {
    "schema_version": {"const": "repo-scout.report.v1"},
    "run_id": {"type": "string"},
    "created_at": {"type": "string"},
    "generated_by": {"type": "object"},
    "status": {"enum": ["completed", "partial", "failed", "blocked", "vetoed"]},
    "repo": {"type": "object"},
    "goal": {"type": "object"},
    "summary": {"type": "string"},
    "verdict": {"type": "object"},
    "claims": {"type": "array"},
    "evidence": {"type": "array"},
    "findings": {"type": "array"},
    "limitations": {"type": "array"}
  }
}
